# Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# Note: The .env file is excluded by .gitignore to prevent secret leakage.

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ADDRESS=localhost

# Application Paths
DATA_RAW_PATH=data/raw/sample_poll_data.csv
DATA_PROCESSED_PATH=data/processed/clean_poll_data.csv
